{
  "name": "HIDE",
  "serveAddress": "127.0.0.1",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Hide": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Hide": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "HideClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
